{
  "name": "daniel-jorg-schuppelius/php-erechnung-toolkit",
  "description": "PHP library for creating, parsing and validating electronic invoices (XRechnung, ZUGFeRD/Factur-X) according to EN 16931.",
  "type": "library",
  "license": "AGPL-3.0-or-later",
  "keywords": [
    "e-rechnung",
    "xrechnung",
    "zugferd",
    "factur-x",
    "en16931",
    "ubl",
    "cii",
    "einvoicing",
    "invoice",
    "peppol",
    "xbestellung",
    "order",
    "peppol-bis-order",
    "order-x"
  ],
  "authors": [
    {
      "name": "Daniel Joerg Schuppelius",
      "email": "info@schuppelius.org"
    }
  ],
  "require": {
    "php": ">=8.1 <8.6",
    "ext-dom": "*",
    "ext-libxml": "*",
    "dschuppelius/php-common-toolkit": "^1.20"
  },
  "autoload": {
    "psr-4": {
      "ERechnungToolkit\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require-dev": {
    "daniel-jorg-schuppelius/php-pdf-toolkit": "^0.8.0",
    "laravel/pint": "^1.27",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.3"
  },
  "suggest": {
    "daniel-jorg-schuppelius/php-pdf-toolkit": "Required for ZUGFeRD/Factur-X PDF generation with embedded XML invoices"
  },
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "format": "vendor/bin/pint --test",
    "format:fix": "vendor/bin/pint",
    "lint": "vendor/bin/phpstan analyse --memory-limit=1G",
    "qa": [
      "@format",
      "@lint",
      "@test"
    ]
  }
}
