    <AddText>
      <OutlineAddText><p><span>Vorbemerkungen</span></p></OutlineAddText>
      <DetailAddText>
        <p style="text-align:center;"><span style="font-weight:bold;">Vorbemerkungen</span></p>
        <p><span/></p>
        <p><span>Die Baustelle ist werktags von 7:00 bis 17:00 Uhr zugänglich.</span></p>
        <p><span>Baustrom und Bauwasser stellt der Auftraggeber </span><span style="font-weight:bold;">kostenlos</span><span> bereit.</span></p>
      </DetailAddText>
    </AddText>
    <AddText>
      <OutlineAddText><p><span>Baubeschreibung</span></p></OutlineAddText>
      <DetailAddText>
        <p><span>Zweigeschossiger Massivbau mit Flachdach, Lageplan siehe Skizze:</span></p>
        <p><image Type="image/png" Encoding="base64">iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChwGA60e6kgAAAABJRU5ErkJggg==</image></p>
      </DetailAddText>
    </AddText>
